{
  "_comment": "CyberLearn Scanner の安全設定 / Safety configuration. 対象は自分のローカル環境のみ。",
  "allowed_hosts": ["localhost", "127.0.0.1", "::1"],
  "allowed_ports": [80, 443, 3000, 5000, 8000, 8080, 8081],
  "allow_http_on_localhost": true,
  "max_requests_per_scan": 10,
  "request_interval_seconds": 1.0,
  "timeout_seconds": 5,
  "user_agent": "CyberLearnScanner/1.0 (educational; local-only)",
  "audit_log_path": "reports/audit_log.jsonl",
  "probe_paths": [
    "/",
    "/nonexistent-page-for-404-test"
  ]
}
